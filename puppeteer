## Case 1: Android (Bypassing Root Detection / SSL Pinning via Web Token)
In this scenario, Puppeteer grabs a fresh, valid JWT from a web session, and Frida hooks the Android OkHttp3 networking library to inject that token into the mobile headers, bypassing native authentication blocks.

import puppeteer from 'puppeteer';import frida from 'frida';
async function runAndroidBounty() {
  // 1. Puppeteer gets the token
  const browser = await puppeteer.launch({ executablePath: '/usr/bin/chromium-browser', args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.goto('https://target.com'); // Automate login here
  const token = await page.evaluate(() => localStorage.getItem('auth_token'));
  await browser.close();

  // 2. Frida injects it into the Android App
  const device = await frida.getUsbDevice();
  const pid = await device.spawn(['com.target.app']);
  const session = await device.attach(pid);

  const fridaCode = `
    Java.perform(function() {
      // Hook OkHttp3 interceptor to force the web token into mobile requests
      var Interceptor = Java.use('okhttp3.Interceptor');
      var Builder = Java.use('okhttp3.Request$Builder');

      Builder.addHeader.implementation = function(name, value) {
        if (name === "Authorization") {
          console.log("[Frida] Replacing old mobile header with Puppeteer web token!");
          return this.addHeader(name, "Bearer " + "${token}");
        }
        return this.addHeader(name, value);
      };
    });
  `;

  const script = await session.createScript(fridaCode);
  await script.load();
  await device.resume(pid);
}

