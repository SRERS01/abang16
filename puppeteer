    Interceptor.attach(openAddr, {
      onEnter: function(args) {
        console.log("[Frida] Thick client opening file asset. Forcing Dev API Key: " + targetBuffer);
        // Custom memory manipulation logic here...
      }
    });
  `;

  const script = await session.createScript(fridaCode);
  await script.load();
  console.log("[+] Interception routine established on thick client.");
}

