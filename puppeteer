## Case 2: iOS (Injecting Web Session State into NSUserDefaults)
Here, Puppeteer completes a complex CAPTCHA-protected login on the web. Frida then catches the target iOS app at launch and forcefully overwrites its local configuration storage (NSUserDefaults) with the cookie parameters extracted by Puppeteer.

import puppeteer from 'puppeteer';import frida from 'frida';
async function runIOSBounty() {
  // 1. Puppeteer gets cookie data
  const browser = await puppeteer.launch({ executablePath: '/usr/bin/chromium-browser', args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.goto('https://target.com'); 
  const cookies = await page.cookies();
  const sessionCookie = cookies.find(c => c.name === 'session_id').value;
  await browser.close();

  // 2. Frida overwrites iOS NSUserDefaults memory
  const device = await frida.getUsbDevice();
  const pid = await device.spawn(['com.target.iosapp']);
  const session = await device.attach(pid);

  const fridaCode = `
    if (ObjC.available) {
      var NSUserDefaults = ObjC.classes.NSUserDefaults;
      var NSString = ObjC.classes.NSString;

      var defaults = NSUserDefaults.standardUserDefaults();
      var key = NSString.stringWithString_("stored_session_key");
      var value = NSString.stringWithString_("${sessionCookie}");

      // Overwrite the mobile app storage with web session data
      defaults.setObject_forKey_(value, key);
      defaults.synchronize();
      console.log("[Frida] Successfully synchronized iOS app data with Puppeteer session.");
    }
  `;

  const script = await session.createScript(fridaCode);
  await script.load();
  await device.resume(pid);
}

